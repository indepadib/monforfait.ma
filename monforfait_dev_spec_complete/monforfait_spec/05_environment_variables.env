# ============================================================
# monforfait.ma — Voice AI Integration
# VARIABLES D'ENVIRONNEMENT — .env
#
# À placer dans le fichier .env du serveur.
# NE JAMAIS COMMITER CE FICHIER dans git.
# Ajouter .env au .gitignore si pas déjà fait.
# ============================================================

# ─── Vapi ────────────────────────────────────────────────────
# Récupérer sur : https://dashboard.vapi.ai/account
VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Récupérer sur : Vapi Dashboard > Assistants > [ton assistant] > ID
VAPI_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Récupérer sur : Vapi Dashboard > Phone Numbers > [ton numéro] > ID
VAPI_PHONE_NUMBER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Générer un secret aléatoire fort (min 32 chars)
# Commande pour générer: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Groq (LLM pas cher) ─────────────────────────────────────
# Récupérer sur : https://console.groq.com/keys
# À configurer dans Vapi Dashboard > Provider Keys > Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Cartesia (TTS pas cher) ─────────────────────────────────
# Récupérer sur : https://play.cartesia.ai/keys
# À configurer dans Vapi Dashboard > Provider Keys > Cartesia
CARTESIA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Deepgram (STT) ──────────────────────────────────────────
# Récupérer sur : https://console.deepgram.com/
# À configurer dans Vapi Dashboard > Provider Keys > Deepgram
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Telnyx (téléphonie moins chère que Twilio) ──────────────
# Récupérer sur : https://portal.telnyx.com/
# À connecter dans Vapi Dashboard > Phone Numbers > Import Telnyx
TELNYX_API_KEY=KEY_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELNYX_CONNECTION_ID=xxxxxxxxxxxxxxxx


# ─── Base de données monforfait.ma ───────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=monforfait_db
DB_USER=monforfait_user
DB_PASSWORD=xxxxxxxxxxxxxxxxxxxx


# ─── Serveur webhook ─────────────────────────────────────────
# URL publique où Vapi enverra les résultats d'appels
# Doit être HTTPS en production
WEBHOOK_BASE_URL=https://monforfait.ma
PORT=3001

# ─── Paramètres d'appel ──────────────────────────────────────
CALL_HOUR_START=8
CALL_HOUR_END=20
MAX_RETRIES=3
RETRY_DELAY_HOURS=4
CALLS_PER_BATCH=5
BATCH_DELAY_SECONDS=6

# ─── Environnement ───────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
